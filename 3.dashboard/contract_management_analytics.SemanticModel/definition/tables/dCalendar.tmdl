	column 'Número do Mês'
		formatString: 0
		lineageTag: ce584f30-703c-40b6-b256-5114a2915cf2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Número do Mês]

		annotation SummarizationSetBy = Automatic

	partition dCalendar = calculated
		mode: import
		source =

				VAR Datas =
				    UNION(
				        SELECTCOLUMNS(vw_contracts, "Data", vw_contracts[validity_start_date]),
				        SELECTCOLUMNS(vw_renewals, "Data", vw_renewals[validity_start_date]),
				        SELECTCOLUMNS(vw_spending, "Data", vw_spending[payment_date])
				    )
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(MINX(Datas, [Data]), MAXX(Datas, [Data])),
				        "Ano", YEAR([Date]),
				        "Trimestre", "T" & QUARTER([Date]),
				        "Ano-Trimestre", FORMAT([Date], "YYYY") & "-T" & QUARTER([Date]),
				        "Ano-Mês", FORMAT([Date], "YYYY-MM"),
				        "Mês", FORMAT([Date], "MMMM"),
				        "Número do Mês", MONTH([Date])
				    )

	annotation PBI_Id = 0139426c5b7a4f478b7740e0ffd4c851
