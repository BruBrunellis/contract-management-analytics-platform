	measure 'Maior Risco por Categoria' =

			VAR Categorias =
			    SELECTCOLUMNS(
			        ALLSELECTED(dCategory[category_key], dCategory[category_name]),
			        "@Key", dCategory[category_key],
			        "@Nome", dCategory[category_name]
			    )
			VAR RiscosPorCategoria =
			    ADDCOLUMNS(
			        Categorias,
			        "@Risco",
			            VAR CategoriaAtual = [@Key]
			            RETURN
			                CALCULATE(
			                    [Risco Final Ponderado],
			                    REMOVEFILTERS(dCategory),
			                    dCategory[category_key] = CategoriaAtual
			                )
			    )
			RETURN
			    MAXX(RiscosPorCategoria, [@Risco])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 50f96fdb-7e48-4db2-a099-3351eae322a8

	measure 'Categoria com Maior Risco' =

			VAR Categorias =
			    SELECTCOLUMNS(
			        ALLSELECTED(dCategory[category_key], dCategory[category_name]),
			        "@Key", dCategory[category_key],
			        "@Nome", dCategory[category_name]
			    )
			VAR RiscosPorCategoria =
			    ADDCOLUMNS(
			        Categorias,
			        "@Risco",
			            VAR CategoriaAtual = [@Key]
			            RETURN
			                CALCULATE(
			                    [Risco Final Ponderado],
			                    REMOVEFILTERS(dCategory),
			                    dCategory[category_key] = CategoriaAtual
			                )
			    )
			RETURN
			    CONCATENATEX(
			        TOPN(1, RiscosPorCategoria, [@Risco], DESC, [@Nome], ASC),
			        [@Nome]
			    )
		lineageTag: 12d8f5a9-8dfa-4b6a-9aa5-b4a8c8e1e8f1

