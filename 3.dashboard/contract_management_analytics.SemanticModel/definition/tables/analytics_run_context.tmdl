	measure 'Contratos Novos no Ano' =

			VAR AnosSelecionados = VALUES(dAno[Ano])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_contracts[contract_key]),
			        REMOVEFILTERS(dCalendar),
			        vw_contracts[contract_type] = "novo_contrato",
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            YEAR(vw_contracts[validity_start_date]) IN AnosSelecionados
			        )
			    )
		formatString: 0
		lineageTag: d7d556ac-6e45-483b-a6f4-ad895eab3ab0

	measure 'Contratos Ativos' =

