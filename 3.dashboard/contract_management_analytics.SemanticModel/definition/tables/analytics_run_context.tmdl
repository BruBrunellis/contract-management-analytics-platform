			RETURN
			    MINX(RiscosPorCategoria, [@Risco])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3bc7fe98-1314-43fe-9635-80e64c7760f3

	measure 'Risco de Aporte' =

			VAR Consumo =
			    DIVIDE(
			        SUM(vw_contracts[total_value]) - SUM(vw_contracts[balance_value]),
			        SUM(vw_contracts[total_value])
			    )
			VAR Inicio =
			    MIN(vw_contracts[validity_start_date])
			VAR Fim =
			    MAX(vw_contracts[validity_end_date])
			VAR Referencia =
			    MAX(analytics_run_context[as_of_date])
			VAR VigenciaDecorrida =
			    IF(
			        ISBLANK(Inicio) || ISBLANK(Fim) || DATEDIFF(Inicio, Fim, DAY) <= 0,
			        BLANK(),
			        MIN(
			            1,
			            MAX(
			                0,
			                DIVIDE(
			                    DATEDIFF(Inicio, Referencia, DAY),
			                    DATEDIFF(Inicio, Fim, DAY)
			                )
			            )
			        )
			    )
			VAR Desvio =
			    Consumo - VigenciaDecorrida
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Consumo) || ISBLANK(VigenciaDecorrida), BLANK(),
			        Desvio >= 0.20, "Alto",
			        Desvio >= 0.05, "Médio",
			        "Baixo"
			    )
		lineageTag: 82662488-5a70-4fbc-a7bf-784275f7c4e4

	measure 'Janela Selecionada (Meses)' =

			SELECTEDVALUE(dJanelaComparacao[Meses], 12)
		formatString: 0
		lineageTag: 00fea5ab-f1f1-4833-a7a5-0f6b8298c43f

	measure 'Valor Contratado — Período Atual' =

			VAR Meses = [Janela Selecionada (Meses)]
			VAR Fim = MAX(analytics_run_context[as_of_date])
			VAR Inicio = EDATE(Fim, -Meses) + 1
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            vw_contracts[validity_start_date] >= Inicio
			                && vw_contracts[validity_start_date] <= Fim
			        )
			    )
			    +
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            vw_renewals[validity_start_date] >= Inicio
			                && vw_renewals[validity_start_date] <= Fim
			        )
			    )
		lineageTag: 3755eaf6-abf4-4124-8ff1-4a8cc1481bd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Contratado — Período Anterior' =

			VAR Meses = [Janela Selecionada (Meses)]
			VAR FimAtual = MAX(analytics_run_context[as_of_date])
			VAR FimAnterior = EDATE(FimAtual, -Meses)
			VAR InicioAnterior = EDATE(FimAtual, -2 * Meses) + 1
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            vw_contracts[validity_start_date] >= InicioAnterior
			                && vw_contracts[validity_start_date] <= FimAnterior
			        )
			    )
			    +
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            vw_renewals[validity_start_date] >= InicioAnterior
			                && vw_renewals[validity_start_date] <= FimAnterior
			        )
			    )
		lineageTag: 1e7aaadf-155e-45c1-9f4d-e28421b8f09c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Anualizado de Contratos Ativos' =

			VAR Referencia =
			    MAX(analytics_run_context[as_of_date])
			RETURN
			    SUMX(
			        FILTER(
			            vw_contracts,
			            vw_contracts[contract_status] = "ativo"
			                && vw_contracts[validity_start_date] <= Referencia
			                && vw_contracts[validity_end_date] >= Referencia
			        ),
			        DIVIDE(
			            vw_contracts[total_value] * 365.25,
			            DATEDIFF(
			                vw_contracts[validity_start_date],
			                vw_contracts[validity_end_date],
			                DAY
			            ) + 1
			        )
			    )
		lineageTag: 7f4caaa1-b62a-4230-8846-fddedef475cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Anualizado Ativo — Fornecedor' =

			VAR Fornecedor =
			    COALESCE(
			        SELECTEDVALUE(dSupplier[supplier_key]),
			        SELECTEDVALUE(vw_contracts[supplier_key])
			    )
			RETURN
			    CALCULATE(
			        [Valor Anualizado de Contratos Ativos],
			        REMOVEFILTERS(vw_contracts),
			        REMOVEFILTERS(dCategory),
			        REMOVEFILTERS(dSupplier),
			        dSupplier[supplier_key] = Fornecedor
			    )
		lineageTag: a4920801-111b-49fc-963c-02101d40092f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Mais Recente — Fornecedor' =

			VAR Fornecedor =
			    COALESCE(
			        SELECTEDVALUE(dSupplier[supplier_key]),
			        SELECTEDVALUE(vw_contracts[supplier_key])
			    )
			VAR DataMaisRecente =
			    MAXX(
			        FILTER(
			            ALL(vw_supplier_financials),
			            vw_supplier_financials[supplier_key] = Fornecedor
			        ),
			        vw_supplier_financials[financial_period_end_date]
			    )
			RETURN
			    SUMX(
			        FILTER(
			            ALL(vw_supplier_financials),
			            vw_supplier_financials[supplier_key] = Fornecedor
			                && vw_supplier_financials[financial_period_end_date] = DataMaisRecente
			        ),
			        vw_supplier_financials[gross_revenue]
			    )
		lineageTag: 11052069-dc98-473b-8952-46ef9435cbe1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dependência Financeira — Fornecedor' =

			DIVIDE(
			    [Valor Anualizado Ativo — Fornecedor],
			    [Faturamento Mais Recente — Fornecedor]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0afeab6e-fa2a-451a-8a3b-d2c69d34d97b

	measure 'Dependência Financeira Ponderada por Categoria' =

			VAR ContratosValidos =
			    FILTER(
			        VALUES(vw_contracts[contract_key]),
			        [Valor Anualizado de Contratos Ativos] > 0
			            && NOT ISBLANK([Dependência Financeira — Fornecedor])
			    )
			RETURN
			    DIVIDE(
			        SUMX(
			            ContratosValidos,
			            [Dependência Financeira — Fornecedor]
			                * [Valor Anualizado de Contratos Ativos]
			        ),
			        SUMX(
			            ContratosValidos,
			            [Valor Anualizado de Contratos Ativos]
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ffecc1a9-4d3c-42e7-ad68-585dabfa92db

	measure 'Valor Contratado — Últimos 12M' =

			VAR Fim =
			    MAX(analytics_run_context[as_of_date])
			VAR Inicio =
			    EDATE(Fim, -12) + 1
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            vw_contracts[validity_start_date] >= Inicio
			                && vw_contracts[validity_start_date] <= Fim
			        )
			    )
			    +
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            vw_renewals[validity_start_date] >= Inicio
			                && vw_renewals[validity_start_date] <= Fim
			        )
			    )
		lineageTag: 349b8baa-5fd3-461b-ab63-38f6f757523e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Status Homologação Atual' =

			VAR Fornecedor =
			    SELECTEDVALUE(dSupplier[supplier_key])
			VAR UltimaAvaliacao =
			    MAXX(
			        FILTER(ALL(vw_rfi), vw_rfi[supplier_key] = Fornecedor),
			        vw_rfi[assessment_date]
			    )
			RETURN
			    MAXX(
			        FILTER(
			            ALL(vw_rfi),
			            vw_rfi[supplier_key] = Fornecedor
			                && vw_rfi[assessment_date] = UltimaAvaliacao
			        ),
			        vw_rfi[homologation_status]
			    )
		lineageTag: d36f1c4d-00c3-45bd-8764-64ea6eb77a3e

	measure 'Risco Final Atual' =

			VAR Fornecedor =
			    SELECTEDVALUE(dSupplier[supplier_key])
			VAR UltimaAvaliacao =
			    MAXX(
			        FILTER(ALL(vw_rfi), vw_rfi[supplier_key] = Fornecedor),
			        vw_rfi[assessment_date]
			    )
			RETURN
			    MAXX(
			        FILTER(
			            ALL(vw_rfi),
			            vw_rfi[supplier_key] = Fornecedor
			                && vw_rfi[assessment_date] = UltimaAvaliacao
			        ),
			        vw_rfi[final_risk]
			    )
		lineageTag: b7d0e769-8069-48b1-994f-ec732b454cf6

	measure 'Valor Contratado 12M — Risco Alto' =

			SUMX(
			    FILTER(
			        VALUES(dSupplier[supplier_key]),
			        [Risco Final Atual] = "alto"
			    ),
			    [Valor Contratado — Últimos 12M]
			)
		lineageTag: 364ca9fd-2d0e-46b4-b485-d61aabe064fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Exposição em Risco Alto' =

			DIVIDE(
			    [Valor Contratado 12M — Risco Alto],
			    [Valor Contratado — Últimos 12M]
			)
		lineageTag: abbe7d27-cb71-4129-91b4-0cddc2a55c94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Check Valor Ativo' =

			VAR ValorAtivo = [Valor Anualizado Ativo — Fornecedor]
			RETURN
			    IF(
			        NOT ISBLANK(ValorAtivo) && ValorAtivo > 0,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 388d6a64-9cca-48ff-aad1-d1e97c4a5688

	measure 'Cenários Financeiros' =

			VAR Referencia =
			    MAX(analytics_run_context[as_of_date])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(dSupplier[supplier_key]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            VALUES(dSupplier[supplier_key]),
			            CALCULATE(
			                COUNTROWS(vw_contracts),
			                REMOVEFILTERS(dCalendar),
			                vw_contracts[contract_status] = "ativo",
			                vw_contracts[validity_start_date] <= Referencia,
			                vw_contracts[validity_end_date] >= Referencia
			            ) > 0
			        )
			    )
		formatString: 0
		lineageTag: 7786f376-4210-4692-ab1e-57310ff18d9d

	measure 'Faturamento — Fornecedores Ativos' =

			CALCULATE(
			    SUM(vw_supplier_financials[gross_revenue]),
			    FILTER(
			        VALUES(dSupplier[supplier_key]),
			        [Valor Anualizado de Contratos Ativos] > 0
			    )
			)
		lineageTag: 95f0722f-0ce9-491a-ae47-f717c43e09b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Custo — Fornecedores Ativos' =

			CALCULATE(
			    SUM(vw_supplier_financials[total_cost]),
			    FILTER(
			        VALUES(dSupplier[supplier_key]),
			        [Valor Anualizado de Contratos Ativos] > 0
			    )
			)
		lineageTag: 2f6a5999-a240-46bc-8da8-e2183359d10c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margem Líquida Ponderada — Fornecedores Ativos' =

			DIVIDE(
			    CALCULATE(
			        SUM(vw_supplier_financials[net_income]),
			        FILTER(
			            VALUES(dSupplier[supplier_key]),
			            [Valor Anualizado de Contratos Ativos] > 0
			        )
			    ),
			    [Faturamento — Fornecedores Ativos]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e20482b1-ace8-4a7b-8b1d-328785f8089b

