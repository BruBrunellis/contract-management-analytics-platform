	measure 'Exibir Contrato Próximo ao Vencimento' =

			VAR Referencia = [Data de Referencia]
			VAR Vencimento = MAX(vw_contracts[validity_end_date])
			RETURN
			    IF(
			        MAX(vw_contracts[contract_status]) = "ativo"
			            && Vencimento >= Referencia
			            && Vencimento <= Referencia + 90,
			        1,
			        0
			    )
		lineageTag: cb5825eb-4de4-4d23-8a89-96702253ade2

	measure 'Data de Referencia' =

			MAX(analytics_run_context[as_of_date])
		formatString: General Date
		lineageTag: fa88f02d-411d-4383-9658-355b49f29abe

	measure 'Percentual de Saldo por Contrato' =

			DIVIDE(
			    SUM(vw_contracts[balance_value]),
			    SUM(vw_contracts[total_value])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 97acecb4-4ece-4c68-aa45-939e5899367d

	measure 'Variação % Valor Contratado por Categoria' =

			VAR Atual = [Valor Contratado — Período Atual]
			VAR Anterior = [Valor Contratado — Período Anterior]
			RETURN
			    IF(
			        ISBLANK(Anterior) || Anterior = 0,
			        BLANK(),
			        DIVIDE(Atual - Anterior, Anterior)
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 68b8cdff-8804-47d9-9914-4c14dca37943

	measure 'Menor Risco por Categoria' =

			VAR Categorias =
			    SELECTCOLUMNS(
			        ALLSELECTED(dCategory[category_key], dCategory[category_name]),
			        "@Key", dCategory[category_key],
			        "@Nome", dCategory[category_name]
			    )
			VAR RiscosPorCategoria =
