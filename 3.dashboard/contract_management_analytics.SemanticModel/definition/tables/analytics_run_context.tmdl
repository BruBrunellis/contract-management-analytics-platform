table analytics_run_context
	lineageTag: 0a49f875-6c95-4dc5-be0e-64a8a880a865

	measure 'Spending Total' = SUM(vw_spending[payment_value])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d95ee7b8-3b55-4a23-83cf-fd17556eecd4

	measure 'Data de Corte' =

			MAX(dCalendar[Date])
		formatString: Short Date
		lineageTag: 05609b81-649b-4f4b-85df-6a4deffa031d

	measure 'Valor Original até o Corte' =

			VAR Corte = [Data de Corte]
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            vw_contracts[validity_start_date] <= Corte
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9e5b2360-e6b3-48cf-939f-ea26d47865e5

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Valor de Renovações até o Corte' =

			VAR Corte = [Data de Corte]
			RETURN
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        vw_renewals[amendment_type] = "renovacao",
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            vw_renewals[validity_start_date] <= Corte
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5f77de68-49b6-4560-adf4-2d547bab97e2

	measure 'Valor de Aportes até o Corte' =

			VAR Corte = [Data de Corte]
			RETURN
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        vw_renewals[amendment_type] = "aporte",
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            vw_renewals[validity_start_date] <= Corte
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 91707835-b080-4294-84e3-94c7cf9a6502

	measure 'Valor Contratado até o Corte' =

			[Valor Original até o Corte]
			    + [Valor de Renovações até o Corte]
			    + [Valor de Aportes até o Corte]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d551342e-8b64-405d-9bfb-0e2a1a1e3b7d

	measure 'Valor Consumido até o Corte' =

			VAR Corte = [Data de Corte]
			RETURN
			    CALCULATE(
			        SUM(vw_spending[payment_value]),
			        FILTER(ALL(dCalendar), dCalendar[Date] <= Corte)
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7fc07735-679a-4f44-9253-c33e85e6e407

	measure 'Saldo Contratual no Corte' =

			[Valor Contratado até o Corte] - [Valor Consumido até o Corte]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 78f0e17d-9b41-427d-8cff-7e6a893a4708

	measure 'Ano Selecionado' =

			COALESCE(SELECTEDVALUE(dAno[Ano]), MAX(dCalendar[Ano]))
		formatString: 0
		lineageTag: 1839f9eb-130b-4de5-85f5-c8e55e32722d

	measure 'Valor Original no Ano' =

			VAR AnosSelecionados = VALUES(dAno[Ano])
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_contracts[validity_start_date]),
			            YEAR(vw_contracts[validity_start_date]) IN AnosSelecionados
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9a0ed679-abf9-44e0-a07c-d283994421d3

	measure 'Valor de Renovações no Ano' =

			VAR AnosSelecionados = VALUES(dAno[Ano])
			RETURN
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        vw_renewals[amendment_type] = "renovacao",
			        FILTER(
			            ALL(vw_renewals[validity_start_date]),
			            YEAR(vw_renewals[validity_start_date]) IN AnosSelecionados
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9dfa5c5e-d933-4fcc-bf95-7d10cea8b898

	measure 'Valor de Aportes no Ano' =

			VAR AnosSelecionados = VALUES(dAno[Ano])
			RETURN
			    CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        vw_renewals[amendment_type] = "aporte",
			        FILTER(
