		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2e352174-a767-4be0-bfe5-dc744a178d32

	measure 'Valor Contratado no Ano' =

			[Valor Original no Ano]
			    + [Valor de Renovações no Ano]
			    + [Valor de Aportes no Ano]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 53131b2e-7258-4d37-a885-8851db120a71

	measure 'Valor Consumido no Ano' =

			VAR AnosSelecionados = VALUES(dAno[Ano])
			RETURN
			    CALCULATE(
			        SUM(vw_spending[payment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(
			            ALL(vw_spending[payment_date]),
			            YEAR(vw_spending[payment_date]) IN AnosSelecionados
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 42bb8b2a-9e65-41f0-b357-ac4cd71963b2

	measure 'Valor Contratado até Fim do Ano' =

			VAR Corte = DATE([Ano Selecionado], 12, 31)
			RETURN
			    CALCULATE(
			        SUM(vw_contracts[original_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(ALL(vw_contracts[validity_start_date]), vw_contracts[validity_start_date] <= Corte)
			    )
			    + CALCULATE(
			        SUM(vw_renewals[amendment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(ALL(vw_renewals[validity_start_date]), vw_renewals[validity_start_date] <= Corte)
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d0006547-ac74-4af0-aa98-a08749f76a51

	measure 'Valor Consumido até Fim do Ano' =

			VAR Corte = DATE([Ano Selecionado], 12, 31)
			RETURN
			    CALCULATE(
			        SUM(vw_spending[payment_value]),
			        REMOVEFILTERS(dCalendar),
			        FILTER(ALL(vw_spending[payment_date]), vw_spending[payment_date] <= Corte)
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 163e6a44-1cb9-4b6e-a23f-7f70c05794e4

	measure 'Saldo em 31 de Dezembro' =

