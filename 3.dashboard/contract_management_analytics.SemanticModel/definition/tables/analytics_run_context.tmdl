	measure 'Vencimento Próximo (90 dias)' =

			VAR Hoje = TODAY()
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_contracts[contract_key]),
			        REMOVEFILTERS(dCalendar),
			        REMOVEFILTERS(vw_contracts[contract_status]),
			        vw_contracts[contract_status] = "ativo",
			        FILTER(
			            ALL(vw_contracts[validity_end_date]),
			            vw_contracts[validity_end_date] >= Hoje
			                && vw_contracts[validity_end_date] <= Hoje + 90
			        )
			    )
		formatString: 0
		lineageTag: 1c8219bb-0488-4650-94e9-f1897f2215dd

