	measure 'Risco Final Ponderado' =

			VAR SaldoExposto =
			    SUMX(
			        FILTER(vw_contracts, vw_contracts[balance_value] > 0),
			        vw_contracts[balance_value]
			    )
			VAR SaldoPonderado =
			    SUMX(
			        FILTER(vw_contracts, vw_contracts[balance_value] > 0),
			        vw_contracts[balance_value]
			            * SWITCH(vw_contracts[final_risk], "alto", 1.0, "medio", 0.5, "baixo", 0.1)
			    )
			RETURN
			    DIVIDE(SaldoPonderado, SaldoExposto)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7eef8d63-79c2-4425-b06a-fe67d97f650e

	measure 'Contratos com Risco Alto' =

			CALCULATE(
			    DISTINCTCOUNT(vw_contracts[contract_key]),
			    vw_contracts[final_risk] = "alto"
			)
		formatString: 0
		lineageTag: 260ed7d8-fc7a-4696-8c95-c3a2ccda4bb4

	measure 'Contratos com Risco Médio' =

